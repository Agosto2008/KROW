# Copia este archivo como ".env" y rellena los valores reales.
# ".env" NUNCA se sube al repo (esta en .gitignore).

# Cadena de conexion a MySQL, formato: mysql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=mysql://root:tu_password@localhost:3306/krow_db_in5bm

# Puerto donde corre el servidor Express
PORT=3000

# Origen permitido para CORS (la URL del frontend Angular)
CORS_ORIGIN=http://localhost:4200

# Clave secreta para firmar los JWT. Usa un valor largo y aleatorio en produccion.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Duracion del token (ej: 1h, 15m, 7d)
JWT_EXPIRES_IN=1h
